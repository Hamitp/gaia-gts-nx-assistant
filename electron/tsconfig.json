{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "../dist-electron",
    "rootDir": "..",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": ["**/*.ts", "../src/domain/**/*.ts", "../src/data/catalogue.ts", "../src/engine/**/*.ts"],
  "exclude": ["**/*.test.ts", "../src/**/*.test.ts"]
}
